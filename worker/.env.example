# Quink pipeline worker — copy to .env and fill in. Never commit .env.

# Gemini. Stage 1 (video->blueprint) + Stage 2 (text polish).
GEMINI_API_KEY=

# Supabase. The worker uses the SERVICE ROLE key: it writes job/article/step rows
# and uploads frames on the user's behalf, so it bypasses RLS by design.
# This key is a full-access secret — server-side only, never ship it to the SPA.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Allowed origin (CORS) for the SPA's worker calls. MUST be the real deployed SPA
# origin in production, e.g. https://app.quink.site — not localhost.
ALLOWED_ORIGIN=http://localhost:5173

# Custom-domain verifier. Defaults to "stub" (dev only: no real DNS, and the
# /api/domain/stub test endpoint is live). PRODUCTION MUST SET dns — otherwise real
# custom domains never verify and the dev stub endpoint stays reachable.
DOMAIN_VERIFIER=stub

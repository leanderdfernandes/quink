# Quink pipeline worker — copy to .env and fill in. Never commit .env.

# WHICH DEPLOYMENT IS THIS: "production" or "staging". REQUIRED — there is no default,
# because the default would have to be a guess, and guessing "production" is what lets a
# staging worker mail real customers. A local worker is `staging` (docs/ENVIRONMENTS.md:
# there is no third tier). main.py refuses to boot on an incoherent combination.
APP_ENV=staging

# Gemini. Stage 1 (video->blueprint) + Stage 2 (text polish).
GEMINI_API_KEY=

# OpenAI. NOT used by the worker — this is the eval judge (eval/run_eval.py), which runs
# on a different provider from the pipeline on purpose (see eval/README.md, Scoring). It
# lives here because eval borrows this venv and this .env. Leave blank if you never run
# the eval. NOTE: run_eval.py reads os.environ directly and does NOT load this file —
# put it in the shell too: PowerShell `$env:OPENAI_API_KEY = "sk-..."`.
OPENAI_API_KEY=

# Supabase. The worker uses the SERVICE ROLE key: it writes job/article/step rows
# and uploads frames on the user's behalf, so it bypasses RLS by design.
# This key is a full-access secret — server-side only, never ship it to the SPA.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Allowed origin(s) (CORS) for the SPA's worker calls. MUST be the real deployed SPA
# origin(s) in production, not localhost. Comma-separate multiple; use https and NO
# trailing slash, e.g. ALLOWED_ORIGIN=https://quink.online,https://www.quink.online
ALLOWED_ORIGIN=http://localhost:5173

# Custom domains. Defaults to "stub" (dev only: no Vercel, no DNS, and the
# /api/domain/stub test endpoint is live). PRODUCTION MUST SET vercel — otherwise real
# custom domains never verify and the dev stub endpoint stays reachable.
DOMAIN_VERIFIER=stub

# Required when DOMAIN_VERIFIER=vercel. Vercel serves the SPA, so it is also what routes
# and issues the TLS cert for customer domains: a host it doesn't know 404s with no
# certificate. The worker registers each connected domain on the project — without these
# a correct CNAME still produces a browser security error.
#   VERCEL_TOKEN      — account token with project domain access (Vercel > Settings > Tokens)
#   VERCEL_PROJECT_ID — the SPA project's ID (Project > Settings > General)
#   VERCEL_TEAM_ID    — team accounts only; leave blank on a personal account
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# How often to re-check pending domains (seconds). Each tick is one API call per pending
# domain, and the per-domain wait backs off from here — keep it >= 60 in production.
DOMAIN_CHECK_INTERVAL_SECONDS=60

# Email. DNS can take hours, so the UI promises "we'll email you the moment it's live".
#
# LEAVE EMAIL_ENABLED UNSET LOCALLY. Sending requires BOTH it and RESEND_API_KEY — the key
# alone is not consent, so a copied production .env can't mail a real customer from your
# laptop, and the test suite can't either. Unset, mailer.py logs the whole payload instead
# and the worker warns at startup if that's the state while serving a non-local origin.
# Set EMAIL_ENABLED=true on Render only.
RESEND_API_KEY=
EMAIL_ENABLED=

# REQUIRED on staging, and it must be UNSET on production. Every outbound message goes to
# this one address instead of the customer, with the real recipient prepended to the
# subject. It is how the four trial-lifecycle templates get exercised at all.
EMAIL_REDIRECT_TO=you@example.com
# Both are real, monitored mailboxes on the verified domain — not a noreply setup.
EMAIL_FROM=Quink <support@quink.online>
EMAIL_REPLY_TO=support@quink.online

# Daily Gemini spend ceiling, in USD. Unset it is $5 (production). A non-production worker
# refuses to boot above $2 — staging bills the same Gemini key production does.
DAILY_SPEND_CAP_USD=2

node_modules/
dist/
.env
.env.local
.env.*.local
__pycache__/
*.pyc
.venv/
venv/
.supabase/
supabase/.temp/
.DS_Store

# Screen recordings — this product ingests them; they can carry on-screen PII and
# don't belong in the repo. (Demo clips, eval inputs, etc.)
*.mp4
*.mov

# eval: keep the code, README and ground-truth notes; not the videos or run outputs
eval/videos/
eval/runs/
eval/results.csv

worker/.env
web/.env

# Generated at build time by web/scripts/build-legal.mjs from legal/*.md. Committing them
# means the repo carries two copies of the same promise and the stale one wins the next
# time someone reads it instead of rebuilding (CLAUDE.md §10: privacy changes ship with
# the policy — one source, which is legal/).
web/public/contact.html
web/public/privacy.html
web/public/refunds.html
web/public/terms.html

# Local scratch. Recordings, .docx drafts and extracted frames used while testing the
# pipeline by hand — customer-shaped content that must never reach the repo.
Article Writer/
Screenshot *.png

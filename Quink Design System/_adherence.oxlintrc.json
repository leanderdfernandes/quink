{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "ui_kits/app/**",
              "ui_kits/first-run/**",
              "ui_kits/marketing/**",
              "ui_kits/reader/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Newsreader|Hanken Grotesk))/i]",
        "message": "Font not provided by the design system. Available: Newsreader, Hanken Grotesk."
      },
      {
        "selector": "JSXOpeningElement[name.name='AvatarStack'] > JSXAttribute > JSXIdentifier[name!=/^(?:people|max|size|style|key|ref|className|style|children)$/]",
        "message": "<AvatarStack> doesn't accept that prop. Declared props: people, max, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Bolt'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|style|key|ref|className|style|children)$/]",
        "message": "<Bolt> doesn't accept that prop. Declared props: height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|iconAfter|pill|full|href|as|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, iconAfter, pill, full, href, as."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|secondary|ghost|critical)$/]",
        "message": "<Button> variant must be one of 'primary' | 'accent' | 'secondary' | 'ghost' | 'critical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|pad|variant|interactive|as|className|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, pad, variant, interactive, as, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:inset|panel)$/]",
        "message": "<Card> variant must be one of 'inset' | 'panel'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|count|on|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, count, on."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dropzone'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|title|sub|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Dropzone> doesn't accept that prop. Declared props: state, title, sub, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dropzone'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:idle|over|loaded)$/]",
        "message": "<Dropzone> state must be one of 'idle' | 'over' | 'loaded'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|optional|htmlFor|children|style|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, hint, optional, htmlFor, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Group'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|count|actions|children|empty|quiet|style|key|ref|className|style|children)$/]",
        "message": "<Group> doesn't accept that prop. Declared props: name, count, actions, children, empty, quiet, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|rotate|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, rotate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|size|tone|raised|iconSize|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, size, tone, raised, iconSize."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm)$/]",
        "message": "<IconButton> size must be one of 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:critical)$/]",
        "message": "<IconButton> tone must be one of 'critical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:search|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: search."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|label|sub|icon|switch|onToggle|critical|disabled|onClick|key|ref|className|style|children)$/]",
        "message": "<MenuItem> doesn't accept that prop. Declared props: type, label, sub, icon, switch, onToggle, critical, disabled, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuItem'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:group|divider)$/]",
        "message": "<MenuItem> type must be one of 'group' | 'divider'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Micro'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|as|color|style|key|ref|className|style|children)$/]",
        "message": "<Micro> doesn't accept that prop. Declared props: children, as, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Notice'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|action|onDismiss|bar|style|key|ref|className|style|children)$/]",
        "message": "<Notice> doesn't accept that prop. Declared props: children, tone, icon, action, onDismiss, bar, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Notice'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|brand|caution|critical)$/]",
        "message": "<Notice> tone must be one of 'neutral' | 'brand' | 'caution' | 'critical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Progress'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|indeterminate|style|key|ref|className|style|children)$/]",
        "message": "<Progress> doesn't accept that prop. Declared props: value, indeterminate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Row'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|desc|meta|state|thumb|actions|arrow|href|onClick|as|className|key|ref|className|style|children)$/]",
        "message": "<Row> doesn't accept that prop. Declared props: title, desc, meta, state, thumb, actions, arrow, href, onClick, as, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Segmented'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Segmented> doesn't accept that prop. Declared props: options, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: options."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|icon|done|title|lede|children|actions|onClose|width|key|ref|className|style|children)$/]",
        "message": "<Sheet> doesn't accept that prop. Declared props: open, icon, done, title, lede, children, actions, onClose, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='State'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|label|sub|size|style|key|ref|className|style|children)$/]",
        "message": "<State> doesn't accept that prop. Declared props: state, label, sub, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='State'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:live|draft|unlisted|edits|building|failed|saving)$/]",
        "message": "<State> state must be one of 'live' | 'draft' | 'unlisted' | 'edits' | 'building' | 'failed' | 'saving'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:target|storageKey|key|ref|className|style|children)$/]",
        "message": "<ThemeToggle> doesn't accept that prop. Declared props: target, storageKey."
      },
      {
        "selector": "JSXOpeningElement[name.name='Thumb'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|index|tall|active|alt|style|key|ref|className|style|children)$/]",
        "message": "<Thumb> doesn't accept that prop. Declared props: src, index, tall, active, alt, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToolbarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|icon|label|on|onClick|key|ref|className|style|children)$/]",
        "message": "<ToolbarItem> doesn't accept that prop. Declared props: type, icon, label, on, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToolbarItem'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:divider)$/]",
        "message": "<ToolbarItem> type must be one of 'divider'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|tone|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: height, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:current|ink|light)$/]",
        "message": "<Wordmark> tone must be one of 'current' | 'ink' | 'light'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }

# Quink SPA — copy to .env.local and fill in. Never commit .env.local.
#
# Both values are PUBLIC (they ship in the browser bundle). That is expected and safe:
# the anon key only grants what RLS allows. Never put the service role key here.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# The FastAPI pipeline worker. Vite inlines this at BUILD time, so it must be set in the
# DEPLOY environment (Vercel > Settings > Environment Variables) too — and changing it there
# only takes effect on the next build, not on the running deployment.
# Unset in production the bundle would fall back to http://localhost:8000 and the deployed
# site would call each visitor's own machine, so the build now fails instead (vite.config.ts).
VITE_WORKER_URL=http://localhost:8000

# WHICH DEPLOYMENT IS THIS: "production" or "staging". REQUIRED — no default. Inlined at
# BUILD time, so it is set per Vercel environment, and changing it there only takes effect
# on the next build. Anything but "production" renders the STAGING bar across the top of
# the authoring app (never on the reader — that must look identical in both environments).
VITE_APP_ENV=staging
